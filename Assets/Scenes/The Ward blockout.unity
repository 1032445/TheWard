--- !u!114 &1518248257
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1518248254}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd8247e9fc96a7f4c95b91b320ab5883, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 729754766}
    spriteOverride: {fileID: 0}
    overrideSortingOrder: 0
    sortingOrder: 0
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: India
      text: You met Pryce yet?
    - speaker: Cyrus
      text: Briefly.
    - speaker: India
      text: Then you got the speech.
    - speaker: Cyrus
      text: The speech?
    - speaker: India
      text: 'The work matters. The floor matters. Don''t interrupt the work. '
    - speaker: Cyrus
      text: He says that a lot?
    - speaker: India
      text: Like his life depended on it.
    - speaker: Cyrus
      text: You sound unimpressed.
    - speaker: India
      text: 'Kind of. It''s hard not to be when someone turns every conversation
        into a plaque on the wall. '
    - speaker: Cyrus
      text: Then why be here?
    - speaker: India
      text: Because my brother sends cards now.
    - speaker: Cyrus
      text: Pardon?
    - speaker: India
      text: Birthday cards. Bad ones.
    - speaker: Cyrus
      text: That sounds normal.
    - speaker: India
      text: It wasn't.
    - speaker: India
      text: Before the trial, he forgot three birthdays in a row.
    - speaker: India
      text: 'Then names. Then whole conversations. '
    - speaker: Cyrus
      text: And Helix helped?
    - speaker: India
      text: This program helped.
    - speaker: India
      text: 'He still has some bad days, but he knows his daughter. '
    - speaker: India
      text: 'He knows when she''s pretending not to cry. '
    - speaker: Cyrus
      text: And that's why you're here?
    - speaker: India
      text: That's why I don't laugh when Pryce says the work matters.
    repeatLines:
    - speaker: Cyrus
      text: You really believe the work matters?
    - speaker: India
      text: I believe the cards.
    storyBeatAfterDialogue: -1
  - minimumStoryBeat: 3
    location: {fileID: 2122135569}
    spriteOverride: {fileID: 0}
    overrideSortingOrder: 0
    sortingOrder: 0
    isVisible: 1
    isInteractable: 0
    lines: []
    repeatLines: []
    storyBeatAfterDialogue: 0
  useScenePlacementForInitialState: 1
  faceDownSprite: {fileID: -7797973452874007986, guid: c676ce2433e0bc64290bd4a3fb253a9d, type: 3}
  faceUpSprite: {fileID: -1040524109570153049, guid: c676ce2433e0bc64290bd4a3fb253a9d, type: 3}
  faceLeftSprite: {fileID: 4485952263068016213, guid: c676ce2433e0bc64290bd4a3fb253a9d, type: 3}
  faceRightSprite: {fileID: -9081275728419918898, guid: c676ce2433e0bc64290bd4a3fb253a9d, type: 3}
