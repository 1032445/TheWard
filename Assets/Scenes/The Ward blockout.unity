--- !u!114 &2086637629
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2086637626}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd8247e9fc96a7f4c95b91b320ab5883, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 1279110320}
    spriteOverride: {fileID: 0}
    overrideSortingOrder: 0
    sortingOrder: 0
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Alan
      text: 'Hey! Sorry to bother you, but do you know where the tech support room
        is? '
    - speaker: Alan
      text: They gave me a map, but there's so many floors and unmarked sections
        that it makes no sense to me.
    - speaker: Cyrus
      text: 'Oh, sorry, it''s the first day for me too. '
    - speaker: Alan
      text: You too? Huh.
    - speaker: Cyrus
      text: Something wrong?
    - speaker: Alan
      text: 'No, just lots of new personnel. '
    - speaker: Cyrus
      text: Is that unusual?
    - speaker: Alan
      text: Maybe not. Some people say they started today, some a few weeks ago,
        some say a few months.
    - speaker: Alan
      text: 'Still, everyone feels pretty new. '
    - speaker: Cyrus
      text: Maybe they're staffing up.
    - speaker: Alan
      text: That's what Emily said.
    - speaker: Cyrus
      text: For what, though?
    - speaker: Alan
      text: No idea.
    - speaker: Alan
      text: Big project, new department, terrible filing system. Take your pick.
    - speaker: Cyrus
      text: And the tech room?
    - speaker: Alan
      text: Is where I'm to report to.
    - speaker: Alan
      text: 'Assuming it exists. '
    repeatLines:
    - speaker: Cyrus
      text: Any luck with the tech room?
    - speaker: Alan
      text: Not unless it snuck up on me while I wasn't looking.
    storyBeatAfterDialogue: -1
  - minimumStoryBeat: 3
    location: {fileID: 1096157811}
    spriteOverride: {fileID: 2583260205964649176, guid: af733219c828545489be1f0152a87e4f, type: 3}
    overrideSortingOrder: 0
    sortingOrder: 0
    isVisible: 1
    isInteractable: 0
    lines: []
    repeatLines: []
    storyBeatAfterDialogue: 0
  useScenePlacementForInitialState: 1
  faceDownSprite: {fileID: -2125810064376001267, guid: af733219c828545489be1f0152a87e4f, type: 3}
  faceUpSprite: {fileID: 2583260205964649176, guid: af733219c828545489be1f0152a87e4f, type: 3}
