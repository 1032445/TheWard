  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 1147941466}
    spriteOverride: {fileID: 0}
    overrideSortingOrder: 0
    sortingOrder: 0
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Claire
      text: Careful on that side, the floor's still damp.
    - speaker: Cyrus
      text: Busy night?
    - speaker: Claire
      text: 'Same as every night. Soup, trays, complaints about the soup. Complaints
        about the trays. Paperwork if someone skips it. '
    - speaker: Cyrus
      text: Paperwork?
    - speaker: Claire
      text: 'Everything here becomes paperwork eventually. '
    - speaker: Cyrus
      text: Even soup?
    - speaker: Claire
      text: Especially soup.
    repeatLines:
    - speaker: Claire
      text: Miss a meal, make a form.
    storyBeatAfterDialogue: 0
  - minimumStoryBeat: 3
