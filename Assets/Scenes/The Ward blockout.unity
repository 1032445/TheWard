  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 1147941466}
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Claire
      text: Careful on that side, the floor's still damp.
    - speaker: Cyrus
      text: Busy night?
    - speaker: Claire
      text: 'Same as every night. Soup, trays, complaints about the soup. Complaints
        about the trays. '
    - speaker: Claire
      text: 'Which would almost be charming if you don''t think about it too hard. '
    - speaker: Cyrus
      text: I'll try not to.
    - speaker: Claire
      text: That's the spirit.
    storyBeatAfterDialogue: 0
  - minimumStoryBeat: 3
    location: {fileID: 2024261802}
    isVisible: 0
    isInteractable: 0
    lines: []
    storyBeatAfterDialogue: 0
