--- !u!114 &421718417
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 421718414}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd8247e9fc96a7f4c95b91b320ab5883, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 1023015603}
    spriteOverride: {fileID: 0}
    overrideSortingOrder: 0
    sortingOrder: 0
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Dean
      text: People misunderstand this place.
    - speaker: Cyrus
      text: Do they?
    - speaker: Dean
      text: They hear "memory research" and think sentiment. Photographs. Names.
        Childhood homes.
    - speaker: Dean
      text: 'But memory is structure. Pattern. Retrieval. Failure points. '
    - speaker: Cyrus
      text: Sounds clinical.
    - speaker: Dean
      text: 'It is. '
    - speaker: Cyrus
      text: Cold, too.
    - speaker: Dean
      text: It can be, until it works.
    - speaker: Cyrus
      text: What changes?
    - speaker: Dean
      text: A chart becomes someone recognising a voice.
    - speaker: Dean
      text: 'A test result becomes someone asking for their daughter by name. '
    - speaker: Dean
      text: 'A pattern becomes one more good day. '
    - speaker: Cyrus
      text: 'That sounds warmer. '
    - speaker: Dean
      text: It is.
    repeatLines:
    - speaker: Dean
      text: The numbers are only cold until they help someone.
    storyBeatAfterDialogue: -1
  - minimumStoryBeat: 3
    location: {fileID: 1993372594}
    spriteOverride: {fileID: 5361948195310768548, guid: 53fe504bbba9e7548a8db6bb30077100, type: 3}
    overrideSortingOrder: 0
    sortingOrder: 0
    isVisible: 1
    isInteractable: 0
    lines: []
    repeatLines: []
    storyBeatAfterDialogue: 0
  useScenePlacementForInitialState: 1
  faceDownSprite: {fileID: 4010523571879354844, guid: 53fe504bbba9e7548a8db6bb30077100, type: 3}
  faceUpSprite: {fileID: 5361948195310768548, guid: 53fe504bbba9e7548a8db6bb30077100, type: 3}
