  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 31ae89aa4cb54304b05db592adcd486f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KitchenDoorInteraction
  patrolTaskNumber: 7
  staffDialogue:
  - speaker: Francis
    text: Whoa, hey! Staff only back here, okay?
  - speaker: Cyrus
    text: Oh? I'm Security. I'm just doing my rounds.
  - speaker: Francis
    text: Well that's all well and good, but I think you'll find that your role is
      to check that the door is secure, not to barge in through it.
  - speaker: Francis
    text: We have to keep people out while we're prepping the food. It's a health
      and safety thing.
  - speaker: Cyrus
    text: 'Whoops, sorry. It''s my first day. '
  - speaker: Francis
    text: 'You don''t say. Anyway, kitchen staff only, thanks. '
  checkedMessage: 
  tooEarlyMessage: This is scheduled later in the patrol.
  alreadyCheckedMessage: The kitchen doors are already checked.
  storyBeatRequiredToOpen: 3
  doorObjectToDisable: {fileID: 1545320863}
  openedMessage: The kitchen doors open.
  showOpenedMessage: 1
