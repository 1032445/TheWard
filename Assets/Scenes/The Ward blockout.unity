  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 1888912315}
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Georgia
      text: You're not here because of the incident, are you?
    - speaker: Cyrus
      text: What incident?
    - speaker: Georgia
      text: Good. Great. Nevermind.
    - speaker: Cyrus
      text: That's.. reassuring?
    - speaker: Georgia
      text: Sorry. I thought you knew something I didn't.
    - speaker: Cyrus
      text: First day jitters?
    - speaker: Georgia
      text: It must be.
    - speaker: Cyrus
      text: Must be?
    - speaker: Georgia
      text: I still don't know where anything is!
    storyBeatAfterDialogue: 0
  - minimumStoryBeat: 3
    location: {fileID: 668676764}
    isVisible: 1
    isInteractable: 0
