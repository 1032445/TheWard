  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 1888912315}
    spriteOverride: {fileID: 0}
    overrideSortingOrder: 0
    sortingOrder: 0
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Georgia
      text: You're not here because of the incident, are you?
    - speaker: Cyrus
      text: What incident?
    - speaker: Georgia
      text: Good. Great. Nevermind.
    - speaker: Cyrus
      text: That's.. reassuring?
    - speaker: Georgia
      text: Sorry. I thought you knew something I didn't.
    - speaker: Cyrus
      text: Does that happen often?
    - speaker: Georgia
      text: More than I'd like.
    - speaker: Cyrus
      text: Not knowing things?
    - speaker: Georgia
      text: 'Knowing just enough to worry. '
    - speaker: Cyrus
      text: About the incident?
    - speaker: Georgia
      text: What incident?
    repeatLines:
    - speaker: Georgia
      text: I don't know what I was worried about.
    - speaker: Georgia
      text: That's worse, isn't it?
    storyBeatAfterDialogue: -1
  - minimumStoryBeat: 3
    location: {fileID: 668676764}
    spriteOverride: {fileID: -4373133255062608305, guid: 59d061006efb75147892e1c4b4014113, type: 3}
    overrideSortingOrder: 0
    sortingOrder: 0
