MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2065954674}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd8247e9fc96a7f4c95b91b320ab5883, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 1882511324}
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Cyrus
      text: So what's Pryce like to work for?
    - speaker: Janet
      text: Direct.
    - speaker: Cyrus
      text: That's one word for it.
    - speaker: Janet
      text: 'Distant, too. But I don''t think that''s a flaw. I think some distance
        can be useful in this kind of work. '
    - speaker: Cyrus
      text: Useful how?
    - speaker: Janet
      text: It stops you pretending something is fine just because saying otherwise
        would be uncomfortable.
    - speaker: Cyrus
      text: And Pryce taught you that?
    - speaker: Janet
      text: He says "clarity is kinder than comfort".
    - speaker: Cyrus
      text: You believe that?
    - speaker: Janet
      text: I believe comfort has lied to me before.
    - speaker: Cyrus
      text: And clarity is better?
    - speaker: Janet
      text: 'Not better. Just harder to be ambushed by. '
    storyBeatAfterDialogue: 0
  - minimumStoryBeat: 3
    location: {fileID: 1225133734}
    isVisible: 1
    isInteractable: 0
    lines: []
    storyBeatAfterDialogue: 0
