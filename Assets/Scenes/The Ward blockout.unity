  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RadioMessageTrigger
  storyBeatToPlay: 1
  delaySeconds: 3
  playOnce: 1
  messageLines:
  - speaker: Radio
    text: Hey, uh.. Security?
  - speaker: Radio
    text: This is Dr. Spiros in the medical bay.
  - speaker: Radio
    text: 'Our cameras are meant to cover a separate quadrant of the room, but one
      of them keeps drifting to the wrong area. '
  - speaker: Radio
    text: It's probably just a loose mount or something, but would you mind coming
      to take a look at it?
  - speaker: Cyrus
    text: Okay, no problem. I'll be there soon.
  audioSource: {fileID: 1676450420}
  radioClip: {fileID: 8300000, guid: c79668e3338c3d2418a63a9b43507712, type: 3}
  loopRadioClipDuringMessage: 1
