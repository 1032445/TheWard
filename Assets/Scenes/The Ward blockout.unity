MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 421718414}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd8247e9fc96a7f4c95b91b320ab5883, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 1023015603}
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Dean
      text: People misunderstand this place.
    - speaker: Cyrus
      text: Do they?
    - speaker: Dean
      text: They hear "memory research" and think sentiment. Photographs. Names.
        Childhood homes.
    - speaker: Dean
      text: 'But memory is structure. Pattern. Retrieval. Failure points. '
    - speaker: Cyrus
      text: Sounds clinical.
    - speaker: Dean
      text: 'It has to be, most days.  '
    - speaker: Cyrus
      text: Most days?
    - speaker: Dean
      text: 'Some days I go home and call my father. Just to make sure I still know
        how. '
    storyBeatAfterDialogue: 0
  - minimumStoryBeat: 3
    location: {fileID: 269971110}
    isVisible: 1
    isInteractable: 0
    lines: []
    storyBeatAfterDialogue: 0
