  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LogbookObject
  logbookPanel: {fileID: 996250411}
  pages:
  - title: Daily Reports
    entry: C-119
    date: 01/03/1971
    system: HX-7B Dietary Distrubution
    area: Floor C Cafeteria
    doseCycle: Evening Meal Service
    batch: HX-7B-44
    machineStatus: Normal
    facilityResponse: Compliance ubiquitous
    notes: Routine distribution completed through staff meal cycle. Personnel were
      not briefed, per Protocol E Restrictions. Intake remained within expected range.
      No recall events observed after previous service.
  - title: Daily Reports
    entry: C-120
    date: 02/03/1971
    system: HX-7B Dietary Distrubution
    area: Floor C Cafeteria
    doseCycle: Evening Meal Service
    batch: HX-7B-44
    machineStatus: Minor pressure variance
    facilityResponse: Partial compliance drift
    notes: 'One security subject missed scheduled intake due to route deviation.
      Subject presented increased questioning and attempted unscheduled conversation
      with kitchen staff. Correction recommended.  '
  - title: Daily Reports
    entry: C-121
    date: 03/03/1971
    system: HX-7B Dietary Distrubution
    area: Floor C Cafeteria
    doseCycle: Evening Meal Service
    batch: HX-7B-44
    machineStatus: Dispenser fault
    facilityResponse: Recall instability unlikely, though possible
    notes: Automated dosage failed for multiple assigned personnel. Exposure group
      may experience memory return, identity fixation, and resistance to posted duties.
      Personnel are to remain confined to their designated areas until maintenance
      restores intake schedule.
  - title: Daily Reports
    entry: C-122
    date: 04/03/1971
    system: HX-7B Dietary Distrubution
    area: Floor C Long Term Personnel
    doseCycle: Emergency Review
    batch: HX-7B-45
    machineStatus: Offline
    facilityResponse: Control loss probable
    notes: 'Long-term exposure records confirm seven-year continuity in subjects,
      despite repeated induction resets. Subjects continue to identify current assignment
      as first shift when dosage is accurately maintained.  '
  minimumStoryBeatToInteract: 3
  storyBeatAfterFirstOpen: 4
  minimumStoryBeatToAdvance: 3
  onlyAdvanceStory: 1
