  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 1155455563}
    spriteOverride: {fileID: 0}
    overrideSortingOrder: 0
    sortingOrder: 0
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Lyanna
      text: Are they still serving?
    - speaker: Cyrus
      text: Dinner?
    - speaker: Lyanna
      text: Anything.
    - speaker: Lyanna
      text: I missed a meal last week and felt off for days.
    - speaker: Cyrus
      text: Off how?
    - speaker: Lyanna
      text: Like the order of things had come loose.
    - speaker: Cyrus
      text: The order of things?
    - speaker: Lyanna
      text: Yeah.
    - speaker: Lyanna
      text: Never doing a long shift without food again.
    repeatLines:
    - speaker: Lyanna
      text: 'It''s easier when things stay in order. '
    storyBeatAfterDialogue: -1
  - minimumStoryBeat: 3
