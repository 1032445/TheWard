MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1000899245}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd8247e9fc96a7f4c95b91b320ab5883, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 614649188}
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Brendan
      text: Ah, hello. Security, right? First night, too?
    - speaker: Cyrus
      text: 'That''s what they tell me. '
    - speaker: Brendan
      text: 'You''ll like it here. It''s quiet, but the work matters. '
    - speaker: Cyrus
      text: What exactly is the work anyway?
    - speaker: Brendan
      text: 'Memory retention. Degenerative conditions. Things people pretend are
        rare until it happens to someone close to them.  '
    - speaker: Brendan
      text: 'My mother had dementia. By the end, she could recite songs from her
        childhood, but couldn''t remember my name. '
    - speaker: Brendan
      text: 'If Helix can spare even one family from that, then all this will be
        worth it.  '
    - speaker: Cyrus
      text: That's a lot to carry.
    - speaker: Brendan
      text: 'It is. But it feels lighter when you can do something. '
    storyBeatAfterDialogue: 0
  - minimumStoryBeat: 3
    location: {fileID: 1183980820}
    isVisible: 1
    isInteractable: 0
    lines: []
    storyBeatAfterDialogue: 0
