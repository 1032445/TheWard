--- !u!114 &1591207865
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1591207862}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd8247e9fc96a7f4c95b91b320ab5883, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 856943661}
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Henry
      text: 'Hey, careful under that camera. They''ve been weird lately. '
    - speaker: Cyrus
      text: Weird how?
    - speaker: Henry
      text: Drifting.
    - speaker: Cyrus
      text: Drifting?
    - speaker: Henry
      text: 'That''s what maintenace calls it when nobody wants the paperwork. '
    - speaker: Cyrus
      text: 'Don''t they adjust all the time? To accurately monitor what''s going
        on? That''s kind of the point of security cameras. '
    - speaker: Henry
      text: Sure. When someone signs off on it.
    - speaker: Cyrus
      text: You think someone is moving them?
    - speaker: Henry
      text: 'I think someone knows where they''re pointed. '
    - speaker: Cyrus
      text: Okay. So why tell me this?
    - speaker: Henry
      text: 'Because I might not remember saying it later. '
    storyBeatAfterDialogue: 0
  - minimumStoryBeat: 3
    location: {fileID: 203816925}
    isVisible: 0
    isInteractable: 0
    lines: []
    storyBeatAfterDialogue: 0
