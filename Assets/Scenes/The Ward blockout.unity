  storyStates:
  - minimumStoryBeat: 0
    location: {fileID: 135281867}
    spriteOverride: {fileID: 0}
    overrideSortingOrder: 0
    sortingOrder: 0
    isVisible: 1
    isInteractable: 1
    lines:
    - speaker: Emily
      text: Do you know where the spare mugs are?
    - speaker: Cyrus
      text: I just started.
    - speaker: Emily
      text: That's what everyone says when they don't want to help.
    - speaker: Cyrus
      text: Everyone?
    - speaker: Emily
      text: Lately, yes.
    - speaker: Emily
      text: New faces, new badges, nobody knows where the mugs are.
    - speaker: Cyrus
      text: Sounds like they're staffing up.
    - speaker: Emily
      text: Then they should start with someone who knows the cupboards.
    repeatLines:
    - speaker: Emily
      text: 'New rule: whoever finds the mugs, runs the floor.'
    storyBeatAfterDialogue: -1
  - minimumStoryBeat: 3
